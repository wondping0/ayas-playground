# ---------------------------------------------------------------------------
# Aya's Playground — environment
#
# Copy to `.env.local`. Everything here has a safe development default EXCEPT
# the secrets, which fail closed when AYA_ENV=production.
# ---------------------------------------------------------------------------

# development | production
AYA_ENV=development

# --- Secrets ---------------------------------------------------------------
# Derives every buyer's flag. Rotating it invalidates flags for orders that
# have not yet been delivered, so rotate deliberately.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AYA_FLAG_SECRET=

# Signs session cookies and download tokens.
AYA_AUTH_SECRET=

# Failed sign-ins allowed per source address AND per account, per 15 minutes.
AYA_LOGIN_MAX_ATTEMPTS=5

# --- Storage ---------------------------------------------------------------
# Unset -> in-memory store. The app boots and is fully usable, but nothing
# survives a restart. Set it to use Postgres:
#   docker compose up -d && npm run db:migrate
# DATABASE_URL=postgres://aya:aya@localhost:5433/aya

# Where uploaded bundles and delivered artifacts live.
AYA_DATA_DIR=.aya-data

# --- Forge (sandbox) -------------------------------------------------------
# docker | stub. `stub` lets the app run without Docker but can NEVER produce a
# passing verification — see .wondev/memory/security-guardrails.md.
AYA_RUNNER=stub

AYA_RUNNER_IMAGE_PYTHON=ayas-playground/runner-python-crypto:1
AYA_RUNNER_IMAGE_SAGE=ayas-playground/runner-sage:1

AYA_RUNNER_TIMEOUT_MS=60000
AYA_RUNNER_MEMORY_MB=512
AYA_RUNNER_PIDS_LIMIT=128
AYA_RUNNER_MAX_OUTPUT_BYTES=262144
AYA_RUNNER_TMPFS_MB=64

# --- Bundle limits ---------------------------------------------------------
AYA_MAX_UPLOAD_BYTES=52428800
AYA_MAX_UNCOMPRESSED_BYTES=209715200
AYA_MAX_BUNDLE_FILES=512

# --- Midtrans --------------------------------------------------------------
# Sandbox credentials from https://dashboard.sandbox.midtrans.com
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# --- Commerce --------------------------------------------------------------
# Hours funds stay pending after delivery before becoming payable.
AYA_DISPUTE_WINDOW_HOURS=72
# Platform commission, in basis points. 1000 = 10%.
AYA_COMMISSION_BPS=1000
# How long a checkout may stay unpaid.
AYA_ORDER_TTL_MINUTES=60
# Fulfilment runs a sandbox after payment, so it retries before giving up.
AYA_MAX_FULFILL_ATTEMPTS=3
AYA_FULFILL_RETRY_BASE_MS=2000
